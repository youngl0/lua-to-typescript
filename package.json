{
  "name": "lua2ts-offline",
  "version": "0.1.0",
  "description": "Deterministic offline Lua-to-TypeScript transpiler with an optional Lua compatibility runtime",
  "type": "module",
  "bin": {
    "lua2ts": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-isolation=none dist/test/*.test.js"
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
